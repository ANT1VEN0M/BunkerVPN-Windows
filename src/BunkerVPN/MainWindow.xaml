<Window x:Class="BunkerVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:BunkerVPN.ViewModels"
        mc:Ignorable="d"
        Title="Бункер Кота VPN"
        Height="600" Width="920"
        MinHeight="540" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel x:Name="ViewModel" />
    </Window.DataContext>

    <!-- Outer Glow & Window Border -->
    <Border Background="{StaticResource BgDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="0" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" /> <!-- Custom TitleBar -->
                <RowDefinition Height="*" />  <!-- Main Content -->
            </Grid.RowDefinitions>

            <!-- ============================================================================== -->
            <!-- 🐾 TITLE BAR -->
            <!-- ============================================================================== -->
            <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                    CornerRadius="13,13,0,0"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="16,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Branding -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Resources/Icons/app_icon.png"
                               Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="БУНКЕР КОТА" Foreground="{StaticResource AccentOrangeBrush}"
                                   FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="VPN" Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold" FontSize="14" Margin="4,0,8,0" VerticalAlignment="Center" />
                        <Border Background="#1C222E" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppVersionDisplay}" Foreground="{StaticResource AccentCyanBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>

                    <!-- Window Controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Click="Minimize_Click" Width="36" Height="30" Margin="2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="—" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                        </Button>
                        <Button Click="Close_Click" Width="36" Height="30" Margin="2,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand">
                            <TextBlock Text="✕" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============================================================================== -->
            <!-- 📱 MAIN BODY (LEFT SIDEBAR + RIGHT CONTENT) -->
            <!-- ============================================================================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" /> <!-- Sidebar -->
                    <ColumnDefinition Width="*" />   <!-- Content Area -->
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,13">
                    <Grid Margin="12,16,12,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Nav Tabs -->
                        <StackPanel Grid.Row="0">
                            <RadioButton x:Name="TabHome" Style="{StaticResource NavTabButtonStyle}"
                                         IsChecked="True" Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock Text="Подключение" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TabServers" Style="{StaticResource NavTabButtonStyle}"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock Text="Серверы" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TabFeeds" Style="{StaticResource NavTabButtonStyle}"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📡" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock Text="Подписки" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TabSettings" Style="{StaticResource NavTabButtonStyle}"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock Text="Настройки" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="TabLogs" Style="{StaticResource NavTabButtonStyle}"
                                         Checked="Tab_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" Margin="0,0,10,0" FontSize="15" />
                                    <TextBlock Text="Консоль / Логи" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Bottom Community Card -->
                        <Border Grid.Row="1" Background="#161B24" CornerRadius="10" Padding="12" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Бункер Кота 🐾" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" FontSize="12" Margin="0,0,0,4" />
                                <TextBlock Text="Создатель: @k0tlux" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" />
                                <TextBlock Text="Чат: @BUNKER_K0TA" Foreground="{StaticResource AccentCyanBrush}"
                                           FontSize="11" Margin="0,2,0,0" Cursor="Hand" MouseDown="TelegramLink_MouseDown" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right Content Switcher -->
                <Grid Grid.Column="1" Margin="24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Update Notification Banner -->
                    <Border Grid.Row="0" Margin="0,0,0,14"
                            Background="#181D26" BorderBrush="{StaticResource AccentOrangeBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🚀" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding UpdateCheckStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" />
                                <ProgressBar Value="{Binding UpdateDownloadProgress}" Maximum="100" Height="4"
                                             Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}"
                                             Foreground="{StaticResource AccentOrangeBrush}" Background="#111" Margin="0,4,0,0" />
                            </StackPanel>
                            <Button Grid.Column="2" Click="ApplyUpdate_Click"
                                    Style="{StaticResource BunkerAccentButtonStyle}"
                                    Content="Обновить" Height="30" Padding="14,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ============================================================== -->
                    <!-- 1. HOME PANEL -->
                    <!-- ============================================================== -->
                    <Grid x:Name="PanelHome" Grid.Row="1" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Center Status & Big Connect Button -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <!-- Glowing Status Ring -->
                            <Grid Width="160" Height="160" Margin="0,0,0,20">
                                <Ellipse Stroke="{Binding StatusColor}" StrokeThickness="4" Opacity="0.3" />
                                <Ellipse Stroke="{Binding StatusColor}" StrokeThickness="2" Width="140" Height="140">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{Binding StatusColor}" BlurRadius="20" ShadowDepth="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}"
                                               FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DurationText}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>

                            <!-- Big Action Button -->
                            <Button Click="ConnectButton_Click"
                                    Width="220" Height="46"
                                    Style="{StaticResource BunkerButtonStyle}"
                                    Background="{Binding ConnectionButtonBackground}"
                                    BorderThickness="0"
                                    FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" Cursor="Hand">
                                <Button.Effect>
                                    <DropShadowEffect Color="#FF6D00" BlurRadius="18" ShadowDepth="0" Opacity="0.4" />
                                </Button.Effect>
                                <TextBlock Text="{Binding ConnectionButtonText}" />
                            </Button>
                        </StackPanel>

                        <!-- 🎮 Game Booster & Discord Fix Card -->
                        <Border Grid.Row="1" Margin="0,8,0,0"
                                Background="{Binding GameBoosterBadgeBackground}"
                                BorderBrush="{Binding GameBoosterBadgeBorder}"
                                BorderThickness="1.5" CornerRadius="12" Padding="14,10"
                                Cursor="Hand" MouseDown="GameBooster_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="🎮" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding GameBoosterBadgeText}" Foreground="{Binding GameBoosterBadgeForeground}"
                                                   FontWeight="Bold" FontSize="12" Margin="0,0,8,0" />
                                        <Border Background="#2B3648" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="TURBO UDP" Foreground="#00E676" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding GameBoosterDescText}" Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <CheckBox Grid.Column="2" IsChecked="{Binding GameBoosterMode}"
                                          VerticalAlignment="Center" Margin="10,0,0,0" Click="GameBooster_Click"/>
                            </Grid>
                        </Border>

                        <!-- Services Unblock Status Grid (Android-style) -->
                        <Border Grid.Row="2" Margin="0,10,0,10" Background="#141923"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="🛡️ СТАТУС РАЗБЛОКИРОВКИ СЕРВИСОВ (ТСПУ BYPASS)"
                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="Bold" />
                                    <TextBlock HorizontalAlignment="Right" Text="{Binding TunnelHealthStatus}"
                                               Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                </Grid>
                                <UniformGrid Columns="3" Rows="2">
                                    <!-- 1. YouTube 4K -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="▶️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="YouTube 4K" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding YtStatusText}" Foreground="{Binding YtStatusColor}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 2. Discord Voice -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🎮" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Discord Voice" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding DiscordStatusText}" Foreground="{Binding DiscordStatusColor}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 3. Telegram SOS -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="✈️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Telegram SOS" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding TgStatusText}" Foreground="{Binding TgStatusColor}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 4. AI Services -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🤖" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="AI (GPT•Claude)" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding AiStatusText}" Foreground="{Binding AiStatusColor}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 5. Instagram / X -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="📸" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Insta / X / Web" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding WebStatusText}" Foreground="{Binding WebStatusColor}" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 6. RU Smart Bypass -->
                                    <Border Background="#1A212E" CornerRadius="8" Padding="10,8" Margin="3">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="🏛️" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="Банки / Госуслуги" Foreground="#FFFFFF" FontSize="11" FontWeight="Bold"/>
                                                <TextBlock Text="⚡ Напрямую (RU)" Foreground="#00E676" FontSize="10"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Bottom Selected Server Info -->
                        <Border Grid.Row="3" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Server Flag / Icon -->
                                <Border Grid.Column="0" Background="#1C212B" CornerRadius="8" Width="44" Height="44" Margin="0,0,14,0">
                                    <TextBlock Text="{Binding SelectedServer.FlagEmoji, FallbackValue='🌐'}"
                                               FontSize="22" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Border>

                                <!-- Server Details -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedServer.Name, FallbackValue='Сервер не выбран'}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="#1C222E" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SelectedServer.Protocol, FallbackValue='VLESS'}"
                                                       Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock Text="Задержка: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding SelectedServer.PingDisplay, FallbackValue='—'}"
                                                   Foreground="{Binding SelectedServer.PingColor, FallbackValue='#6E7681'}"
                                                   FontWeight="SemiBold" FontSize="12" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Change Server Button -->
                                <Button Grid.Column="2" Click="SwitchToServers_Click"
                                        Style="{StaticResource BunkerButtonStyle}"
                                        Content="Сменить" Height="36" Padding="14,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- 2. SERVERS PANEL -->
                    <!-- ============================================================== -->
                    <Grid x:Name="PanelServers" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search & Controls Bar -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38" Background="{StaticResource SurfaceBrush}"
                                     Foreground="{StaticResource TextPrimaryBrush}"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     Padding="12,8" FontSize="13"
                                     VerticalContentAlignment="Center">
                                <TextBox.Resources>
                                    <Style TargetType="{x:Type Border}">
                                        <Setter Property="CornerRadius" Value="8"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>

                            <Button Grid.Column="1" Click="PingAll_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BunkerButtonStyle}" Height="38" Padding="12,0"
                                    ToolTip="Замерить задержку всех серверов и отсортировать">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚡" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding PingButtonText}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Click="SortByPing_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BunkerButtonStyle}" Height="38" Padding="12,0"
                                    ToolTip="Отсортировать сервера: минимальный пинг сверху">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📶" Margin="0,0,6,0" />
                                    <TextBlock Text="По пингу" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Click="UrlTest_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BunkerButtonStyle}" Height="38" Padding="12,0"
                                    ToolTip="Реальный замер скорости HTTP 204 через туннель">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding UrlTestResult}" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" Click="RefreshServers_Click" Margin="8,0,0,0"
                                    Style="{StaticResource BunkerButtonStyle}" Height="38" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" Margin="0,0,6,0" />
                                    <TextBlock Text="Обновить" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Servers List -->
                        <ListView Grid.Row="1" ItemsSource="{Binding FilteredServers}"
                                  SelectedItem="{Binding SelectedServer}"
                                  Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="Margin" Value="0,0,0,8" />
                                    <Setter Property="Padding" Value="12,10" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="8">
                                                    <ContentPresenter />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter Property="Background" Value="#1E2430" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding FlagEmoji}" FontSize="20"
                                                   Margin="0,0,12,0" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                                                       FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Server}" Foreground="{StaticResource TextSecondaryBrush}"
                                                       FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="#1C222E" CornerRadius="4" Padding="6,2" Margin="10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Protocol}" Foreground="{Binding ProtocolBadgeColor}"
                                                       FontSize="11" FontWeight="SemiBold" />
                                        </Border>

                                        <TextBlock Grid.Column="3" Text="{Binding PingDisplay}" Foreground="{Binding PingColor}"
                                                   FontWeight="SemiBold" FontSize="12" Width="60" TextAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- 3. FEEDS PANEL -->
                    <!-- ============================================================== -->
                    <Grid x:Name="PanelFeeds" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Официальные подписки Бункера Кота"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontWeight="Bold" FontSize="16" Margin="0,0,0,14" />

                        <!-- Predefined Feeds -->
                        <ListView Grid.Row="1" ItemsSource="{Binding Feeds}"
                                  Background="Transparent" BorderThickness="0">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                    <Setter Property="Margin" Value="0,0,0,10" />
                                    <Setter Property="Padding" Value="14" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="10">
                                                    <ContentPresenter />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" />
                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Click="SelectFeed_Click" Tag="{Binding Url}"
                                                Style="{StaticResource BunkerButtonStyle}" Content="Выбрать" Height="34" Margin="10,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Custom URL Input -->
                        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Своя ссылка на подписку:" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Settings.CustomSubscriptionUrl, UpdateSourceTrigger=PropertyChanged}"
                                             Height="38" Background="#0E1015" Foreground="{StaticResource TextPrimaryBrush}"
                                             BorderBrush="{StaticResource BorderBrush}" Padding="10,8" FontSize="12" />
                                    <Button Grid.Column="1" Click="ApplyCustomUrl_Click"
                                            Style="{StaticResource BunkerButtonStyle}" Content="Применить"
                                            Height="38" Margin="8,0,0,0" Padding="16,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- 4. SETTINGS PANEL -->
                    <!-- ============================================================== -->
                    <Grid x:Name="PanelSettings" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Режим работы туннеля" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" FontSize="16" Margin="0,0,0,14" />

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <RadioButton x:Name="RadioTunMode" GroupName="VpnModeGroup"
                                                     IsChecked="True" Checked="Mode_Changed" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="🚀 Режим TUN (Глобальный VPN для всего ПК)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="Весь трафик ПК, Discord Voice, онлайн-игры, Steam и браузеры идут через WinTUN адаптер." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </RadioButton>

                                        <Separator Background="{StaticResource BorderBrush}" Margin="0,8,0,12" />

                                        <RadioButton x:Name="RadioProxyMode" GroupName="VpnModeGroup"
                                                     Checked="Mode_Changed">
                                            <StackPanel>
                                                <TextBlock Text="🌐 Системный прокси (HTTP / SOCKS5)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" FontSize="14" />
                                                <TextBlock Text="Настраивает Windows Internet Options. Не требует прав администратора, идеально для браузеров." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Параметры запуска" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" FontSize="16" Margin="0,8,0,14" />

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding Settings.GameBoosterMode}"
                                                  Click="Setting_Changed" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Режим Game Booster &amp; Discord Fix (Full-Cone UDP)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="MTU 1340, Full-Cone NAT. Голос Discord и Brawl Stars через VPN, а CS2/Dota и закачки Steam — напрямую с минимальным пингом." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Settings.BypassRussianSites}"
                                                  Click="Setting_Changed" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Умная маршрутизация (Обход сайтов РФ)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="Сайты РФ (Яндекс, Госуслуги, банки) открываются напрямую, а заблокированные — через VPN." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Settings.AutoSortByPing}"
                                                  Click="Setting_Changed" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="Автосортировка серверов по пингу" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                                <TextBlock Text="Автоматически замерять задержку и ставить самые быстрые серверы наверх." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            </StackPanel>
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Settings.StartWithWindows}"
                                                  Click="AutoStart_Changed" Margin="0,0,0,14">
                                            <TextBlock Text="Запускать BunkerVPN при старте Windows" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Settings.AutoConnectOnStartup}"
                                                  Click="Setting_Changed" Margin="0,0,0,14">
                                            <TextBlock Text="Автоматически подключаться к последнему серверу" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding Settings.MinimizeToTrayOnClose}"
                                                  Click="Setting_Changed">
                                            <TextBlock Text="Сворачивать в системный трей при закрытии крестиком" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Обновления приложения" Foreground="{StaticResource TextPrimaryBrush}"
                                           FontWeight="Bold" FontSize="16" Margin="0,8,0,14" />

                                <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0">
                                            <TextBlock Text="{Binding UpdateCheckStatus}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" />
                                            <CheckBox IsChecked="{Binding Settings.AutoCheckUpdates}"
                                                      Click="Setting_Changed" Margin="0,8,0,0">
                                                <TextBlock Text="Автоматически проверять обновления при запуске" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                            </CheckBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,0">
                                            <Button Click="CheckUpdates_Click" Style="{StaticResource BunkerButtonStyle}"
                                                    Content="Проверить обновления" Height="34" Padding="14,0" />
                                            <Button Click="ApplyUpdate_Click" Style="{StaticResource BunkerAccentButtonStyle}"
                                                    Content="Скачать и установить" Height="34" Margin="10,0,0,0" Padding="14,0"
                                                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============================================================== -->
                    <!-- 5. LOGS PANEL -->
                    <!-- ============================================================== -->
                    <Grid x:Name="PanelLogs" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Консоль ядра sing-box" Foreground="{StaticResource TextPrimaryBrush}"
                                       FontWeight="Bold" FontSize="16" VerticalAlignment="Center" />
                            <Button Click="ClearLogs_Click" HorizontalAlignment="Right"
                                    Style="{StaticResource BunkerButtonStyle}" Content="Очистить" Height="32" Padding="12,0" />
                        </Grid>

                        <Border Grid.Row="1" Background="#0A0B0E" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="10">
                            <ListBox ItemsSource="{Binding Logs}" Background="Transparent" BorderThickness="0"
                                     FontFamily="Consolas" FontSize="12" Foreground="#81C784" />
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
